# Configuração do worker de downloads (npm run worker). Copie para worker.env.
# O worker.env tem o token: nunca commite.

# Endereço do servidor com DOWNLOAD_MODE=worker
SERVER_URL=https://musicplayer.icoders.com.br

# O mesmo WORKER_TOKEN configurado no servidor (Coolify › Environment Variables)
WORKER_TOKEN=

# Opcional: opções extras do yt-dlp neste PC
# YTDLP_ARGS=--sleep-requests 1
