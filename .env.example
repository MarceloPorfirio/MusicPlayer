# Variáveis do app. Em produção, cadastre-as nas Environment Variables do recurso
# no Coolify; localmente, copie para .env. Nunca commite o .env.

# Senha de acesso ao app (obrigatória em servidor público)
APP_PASSWORD=troque-por-uma-senha-forte

# VPS: o YouTube bloqueia IP de datacenter, então quem baixa é o worker no seu PC
# (npm run worker). O servidor só enfileira e recebe os arquivos.
# DOWNLOAD_MODE=worker
# WORKER_TOKEN=<o mesmo do worker.env; gere com: openssl rand -hex 32>

# Modo local (servidor baixando sozinho, ex.: rodando em casa):
# 1 download por vez + pausas entre requisições: menos chance do YouTube marcar o IP.
# --js-runtimes node: o YouTube exige um runtime JS e a imagem já tem Node.
DOWNLOAD_CONCURRENCY=1
YTDLP_ARGS=--js-runtimes node --sleep-requests 1 --sleep-interval 3 --max-sleep-interval 8

# Só se o IP da VPS for bloqueado ("confirm you're not a bot"): cookies de uma conta
# SECUNDÁRIA salvos em /app/data/cookies.txt (dentro do volume). Nunca use sua conta principal.
# YTDLP_ARGS=--js-runtimes node --sleep-requests 1 --sleep-interval 3 --max-sleep-interval 8 --cookies /app/data/cookies.txt
